{
  "Comment": "Leave approval: manager -> (HR if long leave) -> settle balance. No decision within the timeout = reminder email to the SAME approver (never escalates to HR). After too many reminders the request expires.",
  "StartAt": "NotifyManager",
  "States": {
    "NotifyManager": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${NOTIFY_APPROVER_ARN}",
        "Payload": { "stage": "MANAGER", "request.$": "$", "task_token.$": "$$.Task.Token" }
      },
      "TimeoutSecondsPath": "$.approval_timeout",
      "ResultPath": "$.manager_result",
      "Catch": [
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.error", "Next": "RemindManager" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
      ],
      "Next": "ManagerDecision"
    },

    "RemindManager": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WORKFLOW_ACTIONS_ARN}",
        "Payload": { "action": "REMIND", "stage": "MANAGER", "request.$": "$" }
      },
      "ResultSelector": {
        "stage.$": "$.Payload.stage",
        "count.$": "$.Payload.count",
        "give_up.$": "$.Payload.give_up"
      },
      "ResultPath": "$.reminder",
      "Retry": [
        { "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }],
      "Next": "ManagerReminderCheck"
    },

    "ManagerReminderCheck": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.reminder.give_up", "BooleanEquals": true, "Next": "ExpireRequest" }
      ],
      "Default": "NotifyManager"
    },

    "ManagerDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.manager_result.decision", "StringEquals": "APPROVED" },
            { "Variable": "$.requires_hr", "BooleanEquals": true }
          ],
          "Next": "NotifyHR"
        },
        { "Variable": "$.manager_result.decision", "StringEquals": "APPROVED", "Next": "FinalApprove" }
      ],
      "Default": "FinalReject"
    },

    "NotifyHR": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${NOTIFY_APPROVER_ARN}",
        "Payload": { "stage": "HR", "request.$": "$", "task_token.$": "$$.Task.Token" }
      },
      "TimeoutSecondsPath": "$.approval_timeout",
      "ResultPath": "$.hr_result",
      "Catch": [
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.error", "Next": "RemindHR" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }
      ],
      "Next": "HRDecision"
    },

    "RemindHR": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WORKFLOW_ACTIONS_ARN}",
        "Payload": { "action": "REMIND", "stage": "HR", "request.$": "$" }
      },
      "ResultSelector": {
        "stage.$": "$.Payload.stage",
        "count.$": "$.Payload.count",
        "give_up.$": "$.Payload.give_up"
      },
      "ResultPath": "$.reminder",
      "Retry": [
        { "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }],
      "Next": "HRReminderCheck"
    },

    "HRReminderCheck": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.reminder.give_up", "BooleanEquals": true, "Next": "ExpireRequest" }
      ],
      "Default": "NotifyHR"
    },

    "HRDecision": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.hr_result.decision", "StringEquals": "APPROVED", "Next": "FinalApprove" }
      ],
      "Default": "FinalReject"
    },

    "FinalApprove": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WORKFLOW_ACTIONS_ARN}",
        "Payload": { "action": "FINAL_APPROVE", "request.$": "$" }
      },
      "ResultPath": "$.result",
      "Retry": [
        { "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }],
      "End": true
    },

    "FinalReject": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WORKFLOW_ACTIONS_ARN}",
        "Payload": { "action": "FINAL_REJECT", "request.$": "$" }
      },
      "ResultPath": "$.result",
      "Retry": [
        { "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2.0 }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }],
      "End": true
    },

    "ExpireRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WORKFLOW_ACTIONS_ARN}",
        "Payload": { "action": "EXPIRE", "request.$": "$" }
      },
      "ResultPath": "$.result",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "MarkFailed" }],
      "End": true
    },

    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${WORKFLOW_ACTIONS_ARN}",
        "Payload": { "action": "FAIL", "request.$": "$" }
      },
      "ResultPath": "$.result",
      "End": true
    }
  }
}
